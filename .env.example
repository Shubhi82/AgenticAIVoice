# ── Twilio (FREE trial at https://www.twilio.com/try-twilio) ─────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# ── Groq (FREE at https://console.groq.com) ──────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Public URL ────────────────────────────────────────────────────────────
# Local dev:   use ngrok → run: ngrok http 8000 → copy HTTPS URL
# Codespaces:  paste your forwarded port URL
# Render:      paste your deployed URL
PUBLIC_URL=https://your-ngrok-or-render-url.app

# ── App Config ────────────────────────────────────────────────────────────
DATABASE_PATH=data/customers.db
CSV_UPLOAD_DIR=data/uploads
EMI_DUE_DAYS=3
